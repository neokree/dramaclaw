# DramaClaw CE environment variables example
#
# Copy to .env and fill in the real values.
# Generation engines: text MTPLX (local) / OpenRouter; images Draw Things (local) / Higgsfield;
# video Higgsfield / h3.c (local); audio Higgsfield.


# =============================================================================
# 0. Task envelope signing (optional; leave empty for single-host deployments)
# =============================================================================

# Task envelopes are HMAC-signed so their identity can't be rewritten in transit. Single-host
# deployments need no configuration: on first start a local key is generated and stored in
# <NOVELVIDEO_STATE_DIR>/task_envelope_keyring.json (mode 0600) and reused on later restarts.
#
# Configure it explicitly only when several hosts run the same task set: every process must then
# share the same keyring, otherwise one side can't verify what the other signed. Generate a key:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# The active key ID must match ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ and exist in the keyring;
# the keyring may keep retired keys to verify signatures during a rotation window. Keep real
# values only on the host or in a secrets manager.
ST_TASK_ENVELOPE_ACTIVE_KEY_ID=
ST_TASK_ENVELOPE_KEYRING_B64_JSON=


# =============================================================================
# 1. Docker images and text model engine
# =============================================================================

# Image source and version (image mode, docker-compose.release.yml only). By default pulls pinned
# claymorelab/* versions from Docker Hub (see the defaults in that file; the packaging workflow bumps
# them via PR after each release, never latest).
# If pulling from China is slow, switch to the public Aliyun ACR registry. ACR only has the tags
# pinned by releases, no latest, so fill in both lines together:
# DRAMACLAW_IMAGE_PREFIX=claymore-registry.cn-chengdu.cr.aliyuncs.com/dramaclaw
# DRAMACLAW_VERSION=2.0.2

# Text model engine (text requests and text/vision requests with images).
#   mtplx      Default. Local OpenAI-compatible `mtplx serve`, started on demand at the first request, no key.
#   openrouter https://openrouter.ai/api/v1, key from OPENROUTER_API_KEY.
TEXT_ENGINE=mtplx

# MTPLX (defaults in src/novelvideo/engines/mtplx.py). The model has a vision tower and supports image_url.
# MTPLX_BASE_URL=http://127.0.0.1:8000/v1
# MTPLX_MODEL=hawhyhb-qwen36-35b-a3b-uncensored-heretic-mtplx-4bit-fp16
# MTPLX_BINARY=~/.mtplx/bin/mtplx
# MTPLX_MODEL_PATH=~/.mtplx/models/hawhyhb--Qwen3.6-35B-A3B-Uncensored-Heretic-MTPLX-4bit-FP16

# OpenRouter (text model when TEXT_ENGINE=openrouter; also used by a few legacy paths that call OpenRouter directly).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Whether the text model client reads the system proxy. Default: false for mtplx, true for openrouter.
# TEXT_TRUST_ENV=false

# Text model HTTP timeout, in seconds.
TEXT_TIMEOUT_SECONDS=300

# Hermes / director chat model. URL, key and model follow TEXT_ENGINE;
# HERMES_MODEL only applies with openrouter (vendor/model form).
# HERMES_MODEL=
HERMES_MODEL_API_MODE=chat_completions
HERMES_MODEL_CONTEXT_LENGTH=131072


# =============================================================================
# 2. Structured extraction
# =============================================================================

# Concurrency slots for per-chunk extraction (character extraction, scene normalization, scene
# description generation).
STRUCTURED_LLM_CONCURRENCY=2

# =============================================================================
# 3. Text models: per-task overrides (only with TEXT_ENGINE=openrouter)
# =============================================================================
# Empty means OPENROUTER_MODEL. Values must be OpenRouter vendor/model ids; legacy DC-* newAPI
# logical names are ignored. MTPLX serves a single model (MTPLX_MODEL).

# Shot page / AI prompt optimization.
# GLOBAL_VIDEO_OPTIMIZER_MODEL=

# Shot page / Seedance 2.0 panel / AI optimization.
# SEEDANCE2_PROMPT_COMPOSER_MODEL=

# Sketches / AI identity detection and prop color markers.
# GLOBAL_VIDEO_IDENTITY_DETECTOR_MODEL=

# Episode detail / AI identity planning / cast selection.
# IDENTITY_PLANNER_CAST_MODEL=

# Episode detail / AI identity planning / default and other identity analysis.
# IDENTITY_PLANNER_ANALYSIS_MODEL=

# Episode detail / AI identity planning / costume and look description for new identities.
# IDENTITY_PLANNER_APPEARANCE_MODEL=

# Episode detail / line-by-line generation.
# LITERAL_BEAT_META_MODEL=

# Scene library / build from graph / scene parsing, normalization and environment_prompt generation.
# SCENE_BUILD_MODEL=

# Character library / build from source text / structured_v1 per-chunk character extraction and evidence citations.
# CHARACTER_BUILD_MODEL=

# Episode detail / scene planning.
# EPISODE_SCENE_PLANNER_MODEL=

# Episode detail / prop planning.
# EPISODE_PROP_PLANNER_MODEL=

# Freezone / Chinese-English prompt translation.
# FREEZONE_TRANSLATION_MODEL=

# Freezone / AI text writing.
# FREEZONE_TEXT_WRITER_MODEL=

# Freezone / story script generation.
# FREEZONE_STORY_SCRIPT_MODEL=

# Freezone / image-to-prompt, storyboard from video reference and local element recognition; must accept image input.
# FREEZONE_VISION_MODEL=

# Freezone canvas payload limit, in bytes.
FREEZONE_CANVAS_PAYLOAD_LIMIT_BYTES=5242880

# Canvas style gallery. The manifest ships with the package (src/novelvideo/freezone/style_templates.json),
# but the covers and sample images of the 45 styles are not in the repo: ASSET_BASE must point to an
# OSS/CDN prefix, and the frontend builds absolute URLs as `<base>/<relative path in the manifest>`.
# If empty, the gallery shows only placeholder tiles; style names, prompts and filters still work
# (the backend logs a WARNING the first time it serves the manifest).
# You can build the images yourself with scripts/build_style_gallery.py.
# Note: the line below is a placeholder, don't copy it as is. After switching a self-hosted deployment
# to your own domain, also add that domain to the frontend CSP img-src allowlist
# (frontend/docker/nginx.conf.template), otherwise the browser blocks every cover and you get the same
# wall of placeholders as with no configuration.
# To swap the style library without a new release: upload the images under a new prefix and change
# ASSET_BASE, save the manifest elsewhere and point MANIFEST at it. The two are independent; you can
# change just one.
#STYLE_GALLERY_ASSET_BASE=https://cdn.example.com/style-gallery
#STYLE_GALLERY_MANIFEST=/etc/dramaclaw/style_templates.json

# Style page / create a custom style from an uploaded reference image.
# STYLE_ANALYZER_MODEL=

# Content rewrite / source text to short-video voice-over lines.
# CONTENT_REWRITER_MODEL=

# Screenplay normalization.
# SCREENPLAY_NORMALIZER_MODEL=

# 2.0 asset compilation / base scene asset reconciliation.
# EPISODE_SCENE_RECONCILE_MODEL=

# 2.0 asset compilation / narrated drama scene asset planning.
# NARRATED_SCENE_ASSET_MODEL=

# DirectorWorld / Freezone AI temporary prop planning.
# STAGING_PROP_MODEL=
STAGING_PROP_TIMEOUT_SECONDS=120


# =============================================================================
# 4. Image engine selection
# =============================================================================

# Values: "drawthings" (local), "higgsfield:<model>" or "openrouter:<vendor/model>";
# legacy newapi_* / huimeng_* values map to Higgsfield, legacy openrouter_* values map to OpenRouter.
DEFAULT_IMAGE_SELECTION=higgsfield:nano_banana_flash

# Default model for character images.
DEFAULT_CHARACTER_IMAGE_SELECTION=higgsfield:nano_banana_flash

# Default model for shot sketches.
DEFAULT_SKETCH_IMAGE_SELECTION=higgsfield:nano_banana_flash

# Default model for shot renders.
DEFAULT_RENDER_IMAGE_SELECTION=higgsfield:nano_banana_flash

# Image model and quality for DirectorWorld sketches.
DIRECTOR_SKETCH_IMAGE_SELECTION=higgsfield:gpt_image_2
DIRECTOR_SKETCH_IMAGE_QUALITY=low

IMAGE_DEFAULT_STYLE=chinese_period_drama


# =============================================================================
# 5. Video engines (Higgsfield CLI cloud / h3.c local)
# =============================================================================

# Default video backend: higgsfield:<model> (e.g. higgsfield:kling3_0?mode=pro) or h3c.
# Empty means HIGGSFIELD_VIDEO_MODEL; legacy newapi_* / huimeng_* values fall back to the default.
VIDEO_BACKEND=
HIGGSFIELD_VIDEO_MODEL=seedance_2_0?mode=fast
# Seedance 2.0 fast/std; fast only outputs 480p/720p.
HIGGSFIELD_VIDEO_MODE=fast
HIGGSFIELD_VIDEO_RESOLUTION=480p
# Default image model (when the Higgsfield image backend is used).
HIGGSFIELD_IMAGE_MODEL=nano_banana_flash
# higgsfield is looked up on PATH by default (run `higgsfield auth login` first).
# HIGGSFIELD_BINARY=/opt/homebrew/bin/higgsfield
# Model catalog and schema cache (one day), default ~/.cache/dramaclaw/higgsfield.
# HIGGSFIELD_CACHE_DIR=

# Draw Things (local images, HTTP API): URL; empty model and steps use Draw Things' current settings.
DRAWTHINGS_URL=http://127.0.0.1:7860
# DRAWTHINGS_MODEL=
# DRAWTHINGS_STEPS=

# OpenRouter images (key from OPENROUTER_API_KEY): optional models, comma separated;
# empty means google/gemini-3.1-flash-image-preview,openai/gpt-5.4-image-2.
# OPENROUTER_IMAGE_MODELS=

# h3.c (MiniMax H3, local Metal): binary and weights directory.
# H3C_BINARY=/path/to/h3.c/h3
# H3C_WEIGHTS=/path/to/h3.c/MiniMax-H3


# =============================================================================
# 6. Audio (Higgsfield CLI: voices / music / sound effects)
# =============================================================================

# Reference voices (samples uploaded for characters/narrators) use seed_audio; music sonilo_music;
# sound effects mirelo_text_to_audio.
# TTS model, engine and default voice when using Higgsfield's built-in voices (`higgsfield voices list`):
HIGGSFIELD_TTS_MODEL=text2speech_v2
HIGGSFIELD_TTS_VARIANT=elevenlabs
# HIGGSFIELD_TTS_VOICE=<voice id>


# =============================================================================
# 7. Video base parameters
# =============================================================================

VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_BITRATE=4M


# =============================================================================
# 8. UI configuration
# =============================================================================


# Browser-reachable URL of the BuilderGPT Director viewer.
# For LAN collaboration use this machine's LAN IP, e.g. http://192.168.2.206:9024.
DIRECTOR_VIEWER_URL=http://127.0.0.1:9024

# Operator password: protects "export prompts" and the "image generation guard".
# Must be set to your own non-default value; empty = those protected actions are always refused
# (there is no public default password).
PROMPT_EXPORT_PASSWORD=change_me

# Release/feature update notifications. false = release feed fully off: no bundled notes, no GitHub calls.
RELEASE_NOTIFICATIONS_ENABLED=true

# Optional GitHub token to raise the GitHub releases/latest rate limit; empty uses anonymous requests.
RELEASE_NOTIFICATIONS_GITHUB_TOKEN=


# =============================================================================
# 9. Data directories
# =============================================================================

# output, state and runtime all derive from NOVELVIDEO_DATA_ROOT by default.
# Locally the default is the current directory; Docker Compose always uses the persistent volume /data.
# To move the whole data directory, set an absolute path.
# NOVELVIDEO_DATA_ROOT=

# Advanced override: usually not needed; Docker Compose forces /data/output.
# NOVELVIDEO_OUTPUT_DIR=
