# DramaClaw CE 环境变量示例
#
# 复制为 .env 后填写真实值。
# 生成引擎：文本 MTPLX（本地）/ OpenRouter；图像 Draw Things（本地）/ Higgsfield；
# 视频 Higgsfield / h3.c（本地）；音频 Higgsfield。newAPI 网关只剩 cognee embedding 在用。


# =============================================================================
# 0. 任务信封签名（可选；单机部署留空即可）
# =============================================================================

# 任务信封用 HMAC 签名，防止任务在投递途中被改写身份。单机部署无需配置：
# 首次启动自动生成一把本机密钥，存放于 <NOVELVIDEO_STATE_DIR>/task_envelope_keyring.json
# （权限 0600），此后重启复用。
#
# 只有多主机共跑同一套任务时才需要显式配置——此时所有进程必须用同一份 keyring，
# 否则一端签的另一端验不过。生成一把 key：
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# active key ID 须匹配 ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ 且存在于 keyring 中；
# keyring 可同时保留退役 key，供轮换窗口内验签。真实值只放本机或密钥管理系统。
ST_TASK_ENVELOPE_ACTIVE_KEY_ID=
ST_TASK_ENVELOPE_KEYRING_B64_JSON=


# =============================================================================
# 1. newAPI 统一网关
# =============================================================================

# 内置 newapi 后台宿主端口（仅 docker compose 生效）。容器内固定 3000，这里只改宿主映射。
# 默认 3000；端口冲突时改成别的（例如 30000）。
# ST_NEWAPI_PORT=3000

# 镜像来源与版本（仅镜像模式 docker-compose.release.yml 生效）。默认拉 Docker Hub 上 claymorelab/* 的固定版本
# （见文件内默认值，每次发行包打包后由打包 workflow 开 PR 抬，不是 latest）。
# 国内拉取慢可切到阿里云 ACR 公开仓；ACR 只有发行包钉过的 tag，没有 latest，三行要一起填：
# DRAMACLAW_IMAGE_PREFIX=claymore-registry.cn-chengdu.cr.aliyuncs.com/dramaclaw
# DRAMACLAW_VERSION=2.0.2
# DRAMACLAW_GATEWAY_VERSION=v1.0.0-rc.24-dramaclaw.1
# 网关后台端口默认只绑本机回环；要从别的机器访问网关后台时放开：
# ST_NEWAPI_BIND=0.0.0.0
# 源码构建（docker compose up -d --build）默认用与本仓并排的 ../dramaclaw-gateway checkout 构建网关（先 git clone 它）；
# clone 放在别处、或不想 clone 而让 Docker 直接从 git 拉时改这里：
# DRAMACLAW_GATEWAY_SRC=../dramaclaw-gateway
# DRAMACLAW_GATEWAY_SRC=https://github.com/dramaclaw/dramaclaw-gateway.git#main

# 官方渠道在网页「设置 → 模型配置 → 官方渠道」填写 DC key。
# 本地渠道使用 CE 随附的 NewAPI，并由配置向导自动创建运行 token。
# 两种渠道的运行地址和 token 均保存在本机 settings.db，不从环境变量读取。

# CE 本地 NewAPI 配置向导。数据库固定使用本机 SQLite，无需填写 DSN 或路径。
NEWAPI_PROVISIONER_ENABLED=true

# NewAPI 管理地址，不带 /v1；用于 /api/channel/ 和 /api/token/ 管理接口。
NEWAPI_ADMIN_BASE_URL=http://127.0.0.1:3000

NEWAPI_PROVISIONER_INIT_TIMEOUT_MS=120000
NEWAPI_RELAY_TOKEN_NAME=dramaclaw-ce-runtime

# 文本模型引擎（文本与带图的文本/视觉理解请求）。newAPI 不再承载文本请求，
# 只继续用于 embedding。
#   mtplx      默认。本机 OpenAI 兼容服务 `mtplx serve`，首次请求时按需启动，无需 key。
#   openrouter https://openrouter.ai/api/v1，key 取 OPENROUTER_API_KEY。
TEXT_ENGINE=mtplx

# MTPLX（默认值见 src/novelvideo/engines/mtplx.py）。该模型带视觉塔，支持 image_url。
# MTPLX_BASE_URL=http://127.0.0.1:8000/v1
# MTPLX_MODEL=hawhyhb-qwen36-35b-a3b-uncensored-heretic-mtplx-4bit-fp16
# MTPLX_BINARY=~/.mtplx/bin/mtplx
# MTPLX_MODEL_PATH=~/.mtplx/models/hawhyhb--Qwen3.6-35B-A3B-Uncensored-Heretic-MTPLX-4bit-FP16

# OpenRouter（TEXT_ENGINE=openrouter 时的文本模型；也被少数直连 OpenRouter 的旧路径使用）。
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# 文本模型客户端是否读取系统代理。默认：mtplx 为 false，openrouter 为 true。
# TEXT_TRUST_ENV=false

# 文本模型 HTTP 超时时间，单位秒。
TEXT_TIMEOUT_SECONDS=300

# Hermes / 虾导聊天模型。地址、密钥和模型跟随 TEXT_ENGINE；
# HERMES_MODEL 仅在 openrouter 下生效（vendor/model 形式）。
# HERMES_MODEL=
HERMES_MODEL_API_MODE=chat_completions
HERMES_MODEL_CONTEXT_LENGTH=131072


# =============================================================================
# 2. Cognee 知识图谱
# =============================================================================

# 导入小说 / cognify / memify 使用的 LLM：跟随 TEXT_ENGINE。
# COGNEE_LLM_MODEL 仅在 openrouter 下生效（vendor/model 形式）。
# COGNEE_LLM_MODEL=

# 跳过 Cognee 启动连接预检。
COGNEE_SKIP_CONNECTION_TEST=true

# Cognee 启动和旧路径使用的默认模型名。项目实际请求模型由各自
# project_config.json 的 cognee_embedding_model 决定：官方历史项目使用 v1，
# 官方新项目使用 v2，CE 自定义 newAPI 项目使用无后缀兼容模型名。
COGNEE_EMBEDDING_MODEL=DC-cognee-embedding
# Cognee 启动和无项目上下文旧路径的默认维度。项目实际维度由
# project_config.json 的 cognee_embedding_dimension 决定。
COGNEE_EMBEDDING_DIM=1024

# 每次小说导入 pipeline 的上游在途请求上限。多个同时导入的 pipeline 会分别计算。
# LLM 的实体/关系抽取与摘要共享同一个并发额度。
COGNEE_LLM_CONCURRENCY=2

# structured_v1 逐片段抽取的并发槽位（角色抽取、场次规范化、场景描述生成）。
STRUCTURED_LLM_CONCURRENCY=2
# Embedding 并发限制当前仅适用于经 newAPI/custom LiteLLM 发出的请求；其他 provider 会记录绕过日志。
COGNEE_EMBEDDING_BATCH_CONCURRENCY=4

# Cognee embedding 单次请求文本条数。官方默认使用 10，兼容 Qwen / 阿里等低 input 上限模型。
# 如果上游 embedding 模型支持更大批量，可以按需调高。
EMBEDDING_BATCH_SIZE=10

# =============================================================================
# 3. 文本模型：按任务覆盖（仅 TEXT_ENGINE=openrouter 生效）
# =============================================================================
# 留空则使用 OPENROUTER_MODEL。值须为 OpenRouter 的 vendor/model 形式；
# 旧的 DC-* newAPI 逻辑名会被忽略。MTPLX 只服务一个模型（MTPLX_MODEL）。

# 镜头页 / AI 优化提示词。
# GLOBAL_VIDEO_OPTIMIZER_MODEL=

# 镜头页 / Seedance 2.0 面板 / AI 优化。
# SEEDANCE2_PROMPT_COMPOSER_MODEL=

# 草图 / AI 检测身份与道具颜色标记。
# GLOBAL_VIDEO_IDENTITY_DETECTOR_MODEL=

# 剧集详情 / AI 规划身份 / 出场角色筛选。
# IDENTITY_PLANNER_CAST_MODEL=

# 剧集详情 / AI 规划身份 / 默认身份与其他身份分析。
# IDENTITY_PLANNER_ANALYSIS_MODEL=

# 剧集详情 / AI 规划身份 / 新身份服装造型描述。
# IDENTITY_PLANNER_APPEARANCE_MODEL=

# 剧集详情 / 逐行生成。
# LITERAL_BEAT_META_MODEL=

# 场景库 / 从图谱构建 / 场景解析、规范化与 environment_prompt 生成。
# SCENE_BUILD_MODEL=

# 角色库 / 从原文构建 / structured_v1 逐片段角色抽取与证据引用。
# CHARACTER_BUILD_MODEL=

# 剧集详情 / 规划场景。
# EPISODE_SCENE_PLANNER_MODEL=

# 剧集详情 / 规划道具。
# EPISODE_PROP_PLANNER_MODEL=

# Freezone / 文本提示词中英互译。
# FREEZONE_TRANSLATION_MODEL=

# Freezone / AI 文本创作。
# FREEZONE_TEXT_WRITER_MODEL=

# Freezone / 故事脚本生成。
# FREEZONE_STORY_SCRIPT_MODEL=

# Freezone / 图片反推、视频参考生分镜和局部元素识别；必须支持图片输入。
# FREEZONE_VISION_MODEL=

# Freezone 画布 payload 上限，单位字节。
FREEZONE_CANVAS_PAYLOAD_LIMIT_BYTES=5242880

# 画布风格图墙。清单随包发布（src/novelvideo/freezone/style_templates.json），
# 但 45 套风格的封面和示例图不随仓库发布 —— ASSET_BASE 必须指向一个 OSS/CDN 前缀，
# 前端按 `<base>/<清单里的相对路径>` 拼绝对地址。留空则图墙只显示占位块，
# 风格名/提示词/筛选都照常可用（后端启动后首次下发清单时会 WARNING 提示）。
# 图片可用 scripts/build_style_gallery.py 自行构建。
# 注意：下面那行是占位示例，不能直接照抄。自建部署换成自己的域名后，还要把该域名
# 加进前端 CSP 的 img-src 白名单（frontend/docker/nginx.conf.template），否则浏览器
# 会拦掉所有封面，表现和没配一样是一墙占位块。
# 想换一套风格库而不重新发版：图片传新前缀后改 ASSET_BASE，清单另存一处后用
# MANIFEST 指过去。两者互相独立，可以只改其中一个。
#STYLE_GALLERY_ASSET_BASE=https://cdn.example.com/style-gallery
#STYLE_GALLERY_MANIFEST=/etc/dramaclaw/style_templates.json

# 风格页 / 上传参考图创建自定义风格。
# STYLE_ANALYZER_MODEL=

# 内容改写 / 原文转短视频口播逐行文本。
# CONTENT_REWRITER_MODEL=

# 剧本规范化。
# SCREENPLAY_NORMALIZER_MODEL=

# 2.0 资产编译 / 基础场景资产校对。
# EPISODE_SCENE_RECONCILE_MODEL=

# 2.0 资产编译 / 解说剧场景资产规划。
# NARRATED_SCENE_ASSET_MODEL=

# DirectorWorld / Freezone AI 临时道具规划。
# STAGING_PROP_MODEL=
STAGING_PROP_TIMEOUT_SECONDS=120


# =============================================================================
# 4. 图像引擎选择
# =============================================================================

# 选择值："drawthings"（本地）、"higgsfield:<模型>" 或 "openrouter:<vendor/model>"；
# 旧的 newapi_* / huimeng_* 值会映射到 Higgsfield，旧的 openrouter_* 值映射到 OpenRouter。
DEFAULT_IMAGE_SELECTION=higgsfield:nano_banana_flash

# 角色图默认模型。
DEFAULT_CHARACTER_IMAGE_SELECTION=higgsfield:nano_banana_flash

# 镜头草图默认模型。
DEFAULT_SKETCH_IMAGE_SELECTION=higgsfield:nano_banana_flash

# 镜头 render 默认模型。
DEFAULT_RENDER_IMAGE_SELECTION=higgsfield:nano_banana_flash

# DirectorWorld 草图的图像模型与质量。
DIRECTOR_SKETCH_IMAGE_SELECTION=higgsfield:gpt_image_2
DIRECTOR_SKETCH_IMAGE_QUALITY=low

IMAGE_DEFAULT_STYLE=chinese_period_drama


# =============================================================================
# 5. 视频引擎（Higgsfield CLI 云端 / h3.c 本地）
# =============================================================================

# 默认视频后端：higgsfield:<模型>（如 higgsfield:kling3_0?mode=pro）或 h3c。
# 留空时使用 HIGGSFIELD_VIDEO_MODEL；旧的 newapi_* / huimeng_* 值会回落到默认。
VIDEO_BACKEND=
HIGGSFIELD_VIDEO_MODEL=seedance_2_0?mode=fast
# Seedance 2.0 的 fast/std；fast 只出 480p/720p。
HIGGSFIELD_VIDEO_MODE=fast
HIGGSFIELD_VIDEO_RESOLUTION=480p
# 图片默认模型（Higgsfield 图片后端时）。
HIGGSFIELD_IMAGE_MODEL=nano_banana_pro
# 默认按 PATH 查找 higgsfield（需先 `higgsfield auth login`）。
# HIGGSFIELD_BINARY=/opt/homebrew/bin/higgsfield
# 模型目录与 schema 缓存（一天），默认 ~/.cache/dramaclaw/higgsfield。
# HIGGSFIELD_CACHE_DIR=

# Draw Things（本地图片，HTTP API）：地址；模型与步数留空时用 Draw Things 当前设置。
DRAWTHINGS_URL=http://127.0.0.1:7860
# DRAWTHINGS_MODEL=
# DRAWTHINGS_STEPS=

# OpenRouter 图片（key 取 OPENROUTER_API_KEY）：可选模型，逗号分隔；
# 留空时为 google/gemini-3.1-flash-image-preview,openai/gpt-5.4-image-2。
# OPENROUTER_IMAGE_MODELS=

# h3.c（MiniMax H3，本地 Metal）：二进制与权重目录。
# H3C_BINARY=/path/to/h3.c/h3
# H3C_WEIGHTS=/path/to/h3.c/MiniMax-H3


# =============================================================================
# 6. 音频（Higgsfield CLI：声线 / 音乐 / 音效）
# =============================================================================

# 参考声线（角色/解说人上传的样本）走 seed_audio；音乐 sonilo_music；音效 mirelo_text_to_audio。
# 使用 Higgsfield 自带声线（`higgsfield voices list`）时的 TTS 模型、引擎与默认声线：
HIGGSFIELD_TTS_MODEL=text2speech_v2
HIGGSFIELD_TTS_VARIANT=elevenlabs
# HIGGSFIELD_TTS_VOICE=<voice id>


# =============================================================================
# 7. 视频基础参数
# =============================================================================

VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_BITRATE=4M


# =============================================================================
# 8. UI 配置
# =============================================================================


# BuilderGPT Director viewer 对浏览器可访问的地址。
# 局域网协作时改为本机 LAN IP，例如 http://192.168.2.206:9024。
DIRECTOR_VIEWER_URL=http://127.0.0.1:9024

# operator 操作口令：护「导出提示词」与「图像生成防护闸」。
# 必须设为你自己的非默认值；留空 = 这些受护动作一律拒绝(无公开默认口令)。
PROMPT_EXPORT_PASSWORD=change_me

# 版本/功能更新通知。false = 完全关闭 release feed,不读包内 notes、不访问 GitHub。
RELEASE_NOTIFICATIONS_ENABLED=true

# 可选 GitHub token,用于提高 GitHub releases/latest 查询限流额度；留空走匿名请求。
RELEASE_NOTIFICATIONS_GITHUB_TOKEN=


# =============================================================================
# 9. 数据目录
# =============================================================================

# output、state、runtime 默认都从 NOVELVIDEO_DATA_ROOT 派生。
# 本地默认使用当前目录；Docker Compose 固定使用持久化卷 /data。
# 如需整体迁移数据目录，请配置一个绝对路径。
# NOVELVIDEO_DATA_ROOT=

# 高级覆盖：通常无需单独配置；Docker Compose 会强制使用 /data/output。
# NOVELVIDEO_OUTPUT_DIR=
